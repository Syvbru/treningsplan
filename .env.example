# Server-only. Use a separate local/staging Neon database. Never copy production credentials into tests.
POSTGRES_URL=postgresql://local_user:local_password@localhost:5432/treningsplan
# JSON map keyed by SHA-256 of the trimmed lowercase username.
# Each entry: {"hash":"scrypt$... or existing 64-character SHA-256", "name":"Display name", "sheetUrl":"Google CSV export URL", "editPlanSheet":"Google edit URL"}
USER_CREDENTIALS={}
USER_NAMES=
ADMIN_USERNAME_HASH=
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=Trener
# Generate a random 32-byte value outside source control for login bucket HMACs.
AUTH_RATE_LIMIT_SECRET=
FELLES_OKTER_SHEET_URL=
# Signed upload configuration. These replace the former PUBLIC_CLOUDINARY_* variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# JWT_SECRET is no longer used. Old JWT cookies require login after rollout.
